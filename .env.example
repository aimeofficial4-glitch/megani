# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Session signing secret (set a strong random string in production)
SESSION_SECRET="change-me-in-production-to-a-long-random-secret"

# Initial Administrator Bootstrap Password (optional for 2mr@proton.me local login)
ADMIN_INITIAL_PASSWORD=""

# SMTP Configuration for Feedback Notifications (aimeofficial4@gmail.com) and Admin Replies
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="2MR Support <no-reply@2mr.org>"

# MTN Rwanda Mobile Money Collection API (https://momodeveloper.mtn.co.rw/)
# Set MTN_MOMO_ENVIRONMENT="production" only after official MTN Rwanda merchant approval.
MTN_MOMO_ENVIRONMENT="sandbox"
MTN_MOMO_SUBSCRIPTION_KEY=""
MTN_MOMO_API_USER=""
MTN_MOMO_API_KEY=""
MTN_MOMO_TARGET_ENVIRONMENT="sandbox"
MTN_MOMO_CALLBACK_BASE_URL=""
MTN_MOMO_ALLOWED_IPS=""
MTN_MOMO_WEBHOOK_SECRET=""

# Optional Card Payment Gateway
CARD_GATEWAY_SECRET_KEY=""
CARD_GATEWAY_WEBHOOK_SECRET=""

# Multi-AI Provider API Keys (Server-side only - never exposed to browser)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
CUSTOM_AI_BASE_URL=""
CUSTOM_AI_API_KEY=""

# AES-256-GCM encryption key for storing admin-configured AI provider keys in DB
AI_SECRETS_ENCRYPTION_KEY=""

# Official YouTube Data API v3 & 2MR Official Channel
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_HANDLE="@2mr-z5"
YOUTUBE_CHANNEL_ID=""

# Authorized First Administrator Bootstrap (Google OAuth + optional initial password)
ADMIN_BOOTSTRAP_EMAIL="aimeofficial4@gmail.com"

